#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v okflint >/dev/null 2>&1; then
  echo "pre-commit: okflint is required to validate knowledge/." >&2
  echo "Install it with: uv tool install okflint" >&2
  exit 1
fi

if ! command -v lake >/dev/null 2>&1; then
  echo "pre-commit: lake is required to build the Lean project." >&2
  echo "Install elan from: https://lean-lang.org/lean4/doc/setup.html" >&2
  exit 1
fi

okflint validate --manifest knowledge/okf-base.yaml knowledge/
lake build
lake lean tests/FixedPoint.lean
lake lean tests/VBD.lean
lake lean tests/VBDDerivative.lean
