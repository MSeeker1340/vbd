#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v okflint >/dev/null 2>&1; then
  echo "pre-commit: okflint is required to validate knowledge/." >&2
  echo "Install it with: uv tool install okflint" >&2
  exit 1
fi

exec okflint validate --manifest knowledge/okf-base.yaml knowledge/
